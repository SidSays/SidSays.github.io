---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  <url>
    <loc>{{ site.url }}/</loc>
    <image:image>
      <image:loc>{{ site.url }}/assets/img/sid/Siddharth-Sinha-Outdoors.jpg</image:loc>
    </image:image>
  </url>
  <url>
    <loc>{{ site.url }}/professional/</loc>
    <image:image>
      <image:loc>{{ site.url }}/assets/img/sid/siddharth-sinha-professional-headshot.jpg</image:loc>
    </image:image>
  </url>
{% assign sid_photos = site.static_files | where_exp: "f", "f.path contains '/assets/img/sid/'" %}
{% if sid_photos.size > 0 %}
  <url>
    <loc>{{ site.url }}/about/</loc>
{% for f in sid_photos %}{% assign ext = f.extname | downcase %}{% if ext == '.jpg' or ext == '.jpeg' or ext == '.png' or ext == '.webp' %}
    <image:image>
      <image:loc>{{ site.url }}{{ f.path }}</image:loc>
    </image:image>
{% endif %}{% endfor %}
  </url>
{% endif %}
</urlset>
